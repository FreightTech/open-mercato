{
  "name": "@open-mercato/invoicing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*.json": "./src/*.json",
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./dist/*.js"
    },
    "./*/*.json": "./src/*/*.json",
    "./*/*": {
      "types": [
        "./src/*/*.ts",
        "./src/*/*.tsx"
      ],
      "default": "./dist/*/*.js"
    },
    "./*/*/*.json": "./src/*/*/*.json",
    "./*/*/*": {
      "types": [
        "./src/*/*/*.ts",
        "./src/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*.js"
    },
    "./*/*/*/*.json": "./src/*/*/*/*.json",
    "./*/*/*/*": {
      "types": [
        "./src/*/*/*/*.ts",
        "./src/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*.js"
    },
    "./*/*/*/*/*.json": "./src/*/*/*/*/*.json",
    "./*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*.ts",
        "./src/*/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*/*.js"
    },
    "./*/*/*/*/*/*.json": "./src/*/*/*/*/*/*.json",
    "./*/*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*/*.ts",
        "./src/*/*/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*/*/*.js"
    },
    "./*/*/*/*/*/*/*.json": "./src/*/*/*/*/*/*/*.json",
    "./*/*/*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*/*/*.ts",
        "./src/*/*/*/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*/*/*/*.js"
    }
  },
  "dependencies": {
    "@pdfme/common": "^5.5.8",
    "@pdfme/generator": "^5.5.8",
    "@pdfme/schemas": "^5.5.8",
    "fast-xml-parser": "^5.3.4",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@open-mercato/core": "workspace:*",
    "@open-mercato/events": "workspace:*",
    "@open-mercato/queue": "workspace:*",
    "@open-mercato/shared": "workspace:*",
    "@open-mercato/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "esbuild": "^0.24.2",
    "glob": "^11.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
