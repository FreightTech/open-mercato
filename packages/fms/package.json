{
  "name": "@open-mercato/fms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#generated/entities.ids.generated": {
      "types": "./generated/entities.ids.generated.ts",
      "default": "./generated/entities.ids.generated.ts"
    },
    "#generated/entity-fields-registry": {
      "types": "./generated/entity-fields-registry.ts",
      "default": "./generated/entity-fields-registry.ts"
    },
    "#generated/entities/*": {
      "types": "./generated/entities/*/index.ts",
      "default": "./generated/entities/*/index.ts"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./datamodel/entities": "./generated/entities.ids.generated.ts",
    "./*.ts": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*.tsx": {
      "types": "./src/*.tsx",
      "default": "./dist/*.js"
    },
    "./*.json": "./src/*.json",
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./dist/*.js"
    },
    "./*/*.json": "./src/*/*.json",
    "./*/*": {
      "types": [
        "./src/*/*.ts",
        "./src/*/*.tsx"
      ],
      "default": "./dist/*/*.js"
    },
    "./*/*/*.json": "./src/*/*/*.json",
    "./*/*/*": {
      "types": [
        "./src/*/*/*.ts",
        "./src/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*.js"
    },
    "./*/*/*/*.json": "./src/*/*/*/*.json",
    "./*/*/*/*": {
      "types": [
        "./src/*/*/*/*.ts",
        "./src/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*.js"
    },
    "./*/*/*/*/*.json": "./src/*/*/*/*/*.json",
    "./*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*.ts",
        "./src/*/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*/*.js"
    },
    "./*/*/*/*/*/*.json": "./src/*/*/*/*/*/*.json",
    "./*/*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*/*.ts",
        "./src/*/*/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*/*/*.js"
    },
    "./*/*/*/*/*/*/*.json": "./src/*/*/*/*/*/*/*.json",
    "./*/*/*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*/*/*.ts",
        "./src/*/*/*/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*/*/*/*.js"
    },
    "./*/*/*/*/*/*/*/*.json": "./src/*/*/*/*/*/*/*/*.json",
    "./*/*/*/*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*/*/*/*.ts",
        "./src/*/*/*/*/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*/*/*/*/*.js"
    },
    "./*/*/*/*/*/*/*/*/*.json": "./src/*/*/*/*/*/*/*/*/*.json",
    "./*/*/*/*/*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*/*/*/*/*.ts",
        "./src/*/*/*/*/*/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*/*/*/*/*/*.js"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@mistralai/mistralai": "^1.13.0",
    "@open-mercato/core": "workspace:*",
    "@open-mercato/shared": "workspace:*",
    "@open-mercato/ui": "workspace:*",
    "@react-pdf/renderer": "^4.3.2",
    "@react-three/drei": "^10.3.2",
    "@react-three/fiber": "^9.1.2",
    "@uiw/react-textarea-code-editor": "^3.1.1",
    "canvas": "^3.1.0",
    "fast-xml-parser": "^5.3.4",
    "js-yaml": "^4.1.1",
    "pdf-to-img": "^5.0.0",
    "react-json-view": "^1.21.3",
    "react-json-view-lite": "^2.5.0",
    "three": "^0.175.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/three": "^0.175.0",
    "esbuild": "^0.24.2",
    "glob": "^11.0.0"
  }
}
