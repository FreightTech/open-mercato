{
  "workflowId": "booking_lifecycle_v1",
  "workflowName": "Booking Lifecycle V1",
  "version": 1,
  "enabled": true,
  "description": "Phase 1 booking workflow with simplified 5-step process",
  "definition": {
    "steps": [
      {
        "stepId": "start",
        "stepName": "Start",
        "stepType": "START",
        "description": "Workflow initialization"
      },
      {
        "stepId": "draft_created",
        "stepName": "Draft Created",
        "stepType": "AUTOMATED",
        "description": "Booking draft created, emit event",
        "activities": [
          {
            "activityId": "emit_created_event",
            "activityType": "EMIT_EVENT",
            "config": {
              "eventType": "booking.created",
              "payload": {
                "bookingId": "{{context.bookingId}}",
                "bookingNumber": "{{context.bookingNumber}}",
                "clientId": "{{context.clientId}}",
                "cargoType": "{{context.cargoType}}"
              }
            }
          }
        ]
      },
      {
        "stepId": "plan_route",
        "stepName": "Plan Route",
        "stepType": "USER_TASK",
        "description": "User plans shipping route and adds legs",
        "userTaskConfig": {
          "assignedToRoles": ["booking_coordinator", "logistics_manager"],
          "slaDuration": "PT2H",
          "description": "Add route legs for the booking",
          "completionCriteria": {
            "minLegs": 1
          }
        }
      },
      {
        "stepId": "add_cargo",
        "stepName": "Add Cargo Details",
        "stepType": "USER_TASK",
        "description": "User adds cargo/container details",
        "userTaskConfig": {
          "assignedToRoles": ["booking_coordinator", "logistics_manager"],
          "slaDuration": "PT2H",
          "description": "Add containers (FCL) or cargo items (LCL)",
          "completionCriteria": {
            "hasCargo": true
          }
        }
      },
      {
        "stepId": "validated",
        "stepName": "Booking Validated",
        "stepType": "AUTOMATED",
        "description": "Validate booking data is complete",
        "activities": [
          {
            "activityId": "validate_booking",
            "activityType": "CUSTOM",
            "config": {
              "handler": "validateBooking",
              "description": "Validate booking has required data"
            }
          },
          {
            "activityId": "emit_validated_event",
            "activityType": "EMIT_EVENT",
            "config": {
              "eventType": "booking.validated",
              "payload": {
                "bookingId": "{{context.bookingId}}",
                "bookingNumber": "{{context.bookingNumber}}"
              }
            }
          }
        ]
      },
      {
        "stepId": "end",
        "stepName": "End",
        "stepType": "END",
        "description": "Workflow completed"
      }
    ],
    "transitions": [
      {
        "transitionId": "start_to_draft",
        "fromStepId": "start",
        "toStepId": "draft_created",
        "trigger": "auto",
        "description": "Initialize booking"
      },
      {
        "transitionId": "draft_to_plan",
        "fromStepId": "draft_created",
        "toStepId": "plan_route",
        "trigger": "auto",
        "description": "Move to route planning"
      },
      {
        "transitionId": "plan_to_cargo",
        "fromStepId": "plan_route",
        "toStepId": "add_cargo",
        "trigger": "manual",
        "description": "Route planned, add cargo",
        "conditions": [
          {
            "field": "context.legs",
            "operator": "array_length_gte",
            "value": 1
          }
        ]
      },
      {
        "transitionId": "cargo_to_validate",
        "fromStepId": "add_cargo",
        "toStepId": "validated",
        "trigger": "manual",
        "description": "Cargo added, validate booking"
      },
      {
        "transitionId": "validate_to_end",
        "fromStepId": "validated",
        "toStepId": "end",
        "trigger": "auto",
        "description": "Validation complete",
        "conditions": [
          {
            "field": "activityResult.validateBooking.success",
            "operator": "equals",
            "value": true
          }
        ]
      }
    ],
    "errorHandling": {
      "onValidationFailure": {
        "action": "stay",
        "notify": ["assignee", "creator"],
        "message": "Booking validation failed. Please review and fix errors."
      }
    }
  }
}
