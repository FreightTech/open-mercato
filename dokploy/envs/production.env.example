# Dokploy Project Setup Configuration
# Copy to production.env and fill in values.
# Usage: ./dokploy/setup.sh --config dokploy/envs/production.env

# ─── Dokploy Connection ──────────────────────────────────
DOKPLOY_URL=https://dokploy.freighttech.org
DOKPLOY_API_KEY=your-api-key-here

# ─── Project ─────────────────────────────────────────────
PROJECT_NAME=fto-backstage
PROJECT_DESCRIPTION=Invoicing & KSeF backstage services
APP_DOMAIN=backstage.freighttech.org

# ─── Server ID (from Dokploy > Settings > Servers) ──────
# Leave empty to select interactively
SERVER_ID=

# ─── GitHub Source (auto-detected if empty) ──────────────
GITHUB_ID=
GITHUB_OWNER=FreightTech
GITHUB_REPO=open-mercato
GITHUB_BRANCH=freighttechdevel

# ─── Service toggles ────────────────────────────────────
ENABLE_FMS_N8N=true
ENABLE_INF_N8N=false
ENABLE_N8N_RUNNER=false
ENABLE_OPENCODE=false
ENABLE_OTEL=false

# ─── Image versions ─────────────────────────────────────
POSTGRES_IMAGE=pgvector/pgvector:pg17-trixie
N8N_POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MEILISEARCH_IMAGE=getmeili/meilisearch:v1.11
NATS_IMAGE=nats:2.10-alpine
N8N_IMAGE=n8nio/n8n:latest

# ─── Credentials (auto-generated if empty) ───────────────
POSTGRES_PASSWORD=
N8N_POSTGRES_PASSWORD=
JWT_SECRET=
MEILISEARCH_API_KEY=
ENCRYPTION_FALLBACK_KEY=
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
SUPERADMIN_EMAIL=admin@freighttech.org
SUPERADMIN_PASSWORD=
MCP_API_KEY=

# ─── API Keys (optional) ────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
MISTRAL_API_KEY=
GOOGLE_PLACES_API_KEY=
ADMIN_EMAIL=admin@example.com
EMAIL_FROM=

# ─── Backups ─────────────────────────────────────────────
ENABLE_BACKUPS=true
BACKUP_SCHEDULE_PG_MAIN=0 2 * * *
BACKUP_SCHEDULE_PG_N8N=0 3 * * *
BACKUP_RETENTION=7
BACKUP_PREFIX=
# Leave empty to auto-detect or select interactively
S3_DESTINATION_ID=

# ─── Deploy ──────────────────────────────────────────────
# Auto-deploy all services after creation (default: true)
AUTO_DEPLOY=true

# ─── Monitoring (optional) ──────────────────────────────
NEW_RELIC_APP_NAME=
NEW_RELIC_LICENSE_KEY=
