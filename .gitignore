# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.turbo

# testing
/coverage
/test-results
/playwright-report
published-app/

# next.js
.next/
/out/

# production
build
.docusaurus

# misc
.DS_Store
*.pem
data/cache.db

# Exception: Allow public CA certificates for SSL verification
!certs/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.preview
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.tsbuild/


# /**/migrations/*
# Generated module files
/src/generated/
/src/generated/*
/generated/
packages/*/generated/
# Exception: example entities needed for core/query_index dynamic import fallback
!packages/example/generated/
!packages/example/generated/entities.ids.generated.ts
packages/client/src/generated/
# package build outputs
packages/*/dist/
packages/**/dist/
.mercato

# runtime/event state
.events/

# prevent accidental check-in of transpiled JS alongside TS sources
src/**/*.js
src/**/*.jsx
packages/*/src/**/*.js
packages/*/src/**/*.jsx
.test-cache.json

tmp/

public/uploads/*
apps/mercato/storage/*
apps/mercato/storage/attachments/*
storage
apps/mercato/data
packages/client/src/generated/openapi.types.ts
package-lock.json

# IDE related
.idea
.claude
.codex

# Claude Code MCP config (may contain API keys)
.mcp.json
.vscode/settings.json
packages/cache/node_modules/*
newrelic_agent.log
/generated/
debug-storybook.log
*storybook.log
storybook-static
.queue/**
.queue

# Dev Container auto-generated compose volumes
.devcontainer/docker-compose.volumes.yml

# OpenCode local config (generated at runtime, may contain secrets)
docker/opencode/opencode.jsonc
.vscode/launch.json
opencode.json

# Carrier config seeds (contains credentials)
**/seed-carrier-configs.ts

# Local npm registry (Verdaccio)
.npmrc
!.npmrc.local

# MCPs
.playwright-mcp

apps/mercato/e2e-report
apps/mercato/test-results
.ai/qa/ephemeral-env.lock/owner.json
.ai/qa/ephemeral-env.lock/*
.ai/qa/ephemeral*
.ai/dev-ephemeral-envs.json
.agents/
