{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "cache": false,
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "mcp:dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "cache": false,
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "generate": {
      "dependsOn": ["@open-mercato/cli#build"],
      "cache": false,
      "outputs": [".mercato/**"]
    },
    "reinstall": {
      "cache": false,
      "outputs": []
    },
    "initialize": {
      "cache": false,
      "outputs": []
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
